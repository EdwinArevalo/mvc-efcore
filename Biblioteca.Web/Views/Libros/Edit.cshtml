@model Libro
@{
    ViewData["Title"] = "Editar libro";
}

<h1>Editar libro</h1>

<form asp-action="Edit" asp-route-id="@Model.IdLibro" class="col-md-6">
    <input type="hidden" asp-for="IdLibro" />
    <partial name="_Form" model="Model" />
    <button class="btn btn-primary">Guardar cambios</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
</form>
