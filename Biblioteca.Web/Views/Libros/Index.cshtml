@model IEnumerable<Libro>
@{
    ViewData["Title"] = "Libros";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Libros</h1>
    <a class="btn btn-primary" asp-action="Create">Nuevo libro</a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-3">
        <select name="idAutor" class="form-select" asp-items="ViewBag.Autores">
            <option value="">Todos los autores</option>
        </select>
    </div>
    <div class="col-sm-6 col-md-4">
        <input name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Buscar por título" />
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-primary">Filtrar</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Limpiar</a>
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Título</th>
            <th>Autor</th>
            <th>ISBN</th>
            <th>Año</th>
            <th class="text-end">Precio</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var l in Model)
        {
            <tr>
                <td>@l.Titulo</td>
                <td>@l.IdAutorNavigation.Nombre</td>
                <td>@l.Isbn</td>
                <td>@l.AnioPublicacion</td>
                <td class="text-end">@l.Precio.ToString("C")</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@l.IdLibro">Detalle</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@l.IdLibro">Editar</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@l.IdLibro">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">No se encontraron libros.</p>
}
