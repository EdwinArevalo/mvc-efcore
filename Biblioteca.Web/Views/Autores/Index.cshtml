@model IEnumerable<Autor>
@{
    ViewData["Title"] = "Autores";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Autores</h1>
    <a class="btn btn-primary" asp-action="Create">Nuevo autor</a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-4">
        <input name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Buscar por nombre" />
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-primary">Buscar</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Limpiar</a>
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Nacionalidad</th>
            <th class="text-center">Libros</th>
            <th class="text-end">Precio promedio</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.Nombre</td>
                <td>@a.Nacionalidad</td>
                <td class="text-center">@a.Libros.Count</td>
                <td class="text-end">@(a.Libros.Any() ? a.Libros.Average(l => l.Precio).ToString("C") : "-")</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@a.IdAutor">Detalle</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@a.IdAutor">Editar</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@a.IdAutor">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
