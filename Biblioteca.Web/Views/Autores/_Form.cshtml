@model Autor

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3">
    <label asp-for="Nombre" class="form-label">Nombre</label>
    <input asp-for="Nombre" class="form-control" maxlength="100" />
    <span asp-validation-for="Nombre" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Nacionalidad" class="form-label">Nacionalidad</label>
    <input asp-for="Nacionalidad" class="form-control" maxlength="50" />
    <span asp-validation-for="Nacionalidad" class="text-danger"></span>
</div>
