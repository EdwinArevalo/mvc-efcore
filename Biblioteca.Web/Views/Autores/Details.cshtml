@model Autor
@{
    ViewData["Title"] = Model.Nombre;
}

<h1>@Model.Nombre</h1>
<p class="text-muted">@(Model.Nacionalidad ?? "Nacionalidad no registrada")</p>

<h2 class="h4">Libros (@Model.Libros.Count)</h2>
@if (Model.Libros.Any())
{
    <table class="table table-striped">
        <thead>
            <tr><th>Título</th><th>Año</th><th class="text-end">Precio</th></tr>
        </thead>
        <tbody>
            @foreach (var libro in Model.Libros)
            {
                <tr>
                    <td><a asp-controller="Libros" asp-action="Details" asp-route-id="@libro.IdLibro">@libro.Titulo</a></td>
                    <td>@libro.AnioPublicacion</td>
                    <td class="text-end">@libro.Precio.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Este autor no tiene libros activos.</p>
}

<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.IdAutor">Editar</a>
<a class="btn btn-outline-secondary" asp-action="Index">Volver</a>
