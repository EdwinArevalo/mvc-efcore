{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/Biblioteca.Web/Biblioteca.Web.csproj"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "watch",
      "command": "dotnet",
      "type": "process",
      "args": ["watch", "run", "--project", "${workspaceFolder}/Biblioteca.Web/Biblioteca.Web.csproj"],
      "problemMatcher": "$msCompile",
      "isBackground": true
    },
    {
      "label": "BD: levantar y cargar BibliotecaDB",
      "type": "shell",
      "command": "./scripts/cargar-bd.sh",
      "problemMatcher": []
    },
    {
      "label": "BD: ejecutar ModificarLibro.sql",
      "type": "shell",
      "command": "./scripts/cargar-bd.sh ModificarLibro.sql",
      "problemMatcher": []
    },
    {
      "label": "Scaffold: regenerar Models",
      "type": "shell",
      "command": "./scripts/scaffold.sh",
      "problemMatcher": []
    }
  ]
}
